{
  "name": "pocket-base",
  "version": "1.3.3",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "setup": "node scripts/first-run.mjs",
    "predev": "node scripts/migrate.mjs dev",
    "prebuild": "node scripts/migrate.mjs build",
    "db:migrate": "node scripts/migrate.mjs migrate",
    "auth:check": "node scripts/configure-auth.mjs",
    "auth:configure": "node scripts/configure-auth.mjs --apply"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "acorn": "^8.19.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "parse5": "^8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

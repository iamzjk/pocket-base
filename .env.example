# Local starter playground. Disabled on Vercel and non-loopback hosts.
POCKET_BASE_DEMO=true

# Set these for your real family studio, then set POCKET_BASE_DEMO=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/build only: Supabase ACCOUNT access token for automatic migrations.
# Create at https://supabase.com/dashboard/account/tokens. Not a project API key.
# No CLI login or Keychain is used. Optional after all migrations are applied.
SUPABASE_ACCESS_TOKEN=

# Server only. Never prefix this with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Providers are capped at $0.30 input / $1.20 output per million tokens.
# To require free inference, set OPENROUTER_MODEL=openrouter/free.

# Local starter playground. Disabled on Vercel and non-loopback hosts.
POCKET_BASE_DEMO=true

# Set these for your real family studio, then set POCKET_BASE_DEMO=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after Google provider setup and callback verification. Keep previews off.
POCKET_BASE_GOOGLE_SIGN_IN=false
POCKET_BASE_SITE_URL=
# Private setup-command credentials; never expose these through NEXT_PUBLIC_.
# Needed only for npm run auth:configure -- --google, not by the app runtime.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server/build only: Supabase ACCOUNT access token for automatic migrations.
# Create at https://supabase.com/dashboard/account/tokens. Not a project API key.
# No CLI login or Keychain is used. Optional after all migrations are applied.
SUPABASE_ACCESS_TOKEN=

# Server only. Never prefix this with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-terra
OPENROUTER_PLANNER_MODEL=openai/gpt-6.1-sol
# New games: Sol plan -> Terra build. Edits: one Terra request.
# Terra defaults to $1 input / $5 output; Sol to $2 / $10 per million tokens.
# DeepSeek remains configurable: ~deepseek/deepseek-flash-latest ($0.30 / $1.20).
# For free inference, set BOTH models above to openrouter/free.

# Generation settings. Prices are USD per million tokens; blank uses model defaults.
# Custom paid model IDs require both price caps. No automatic retries or fallbacks.
OPENROUTER_MAX_INPUT_PRICE=
OPENROUTER_MAX_OUTPUT_PRICE=
OPENROUTER_MAX_OUTPUT_TOKENS=100000
OPENROUTER_REASONING_EFFORT=medium
# price, latency, or throughput; the price caps apply to every choice.
OPENROUTER_PROVIDER_SORT=price

# Planning settings are independent of the builder settings above.
OPENROUTER_PLANNER_MAX_INPUT_PRICE=
OPENROUTER_PLANNER_MAX_OUTPUT_PRICE=
OPENROUTER_PLANNER_MAX_OUTPUT_TOKENS=8000
OPENROUTER_PLANNER_REASONING_EFFORT=medium
OPENROUTER_PLANNER_PROVIDER_SORT=price
POCKET_BASE_MAX_PLAN_WORDS=400
POCKET_BASE_PLANNING_TIMEOUT_MS=60000

# Prompt default matches Base44's documented chat API limit.
POCKET_BASE_MAX_PROMPT_CHARACTERS=100000
# Source bytes; default 5MB, database ceiling 10MB. Large JSON responses are streamed.
POCKET_BASE_MAX_GAME_BYTES=5000000
# Shared deadline for planning AND building, including receiving both responses.
# Maximum 350000 with the six-minute attempt lease and default route duration.
POCKET_BASE_GENERATION_TIMEOUT_MS=300000
# vercel.json defaults to 360 seconds, requiring Vercel Pro/Enterprise.
# For Hobby: set that duration to 300 and the timeout above to 290000.

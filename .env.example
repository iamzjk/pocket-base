# Local starter playground. Disabled on Vercel and non-loopback hosts.
POCKET_BASE_DEMO=true

# Set these for your real family studio, then set POCKET_BASE_DEMO=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
